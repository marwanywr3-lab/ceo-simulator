{
  "name": "ceo-simulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "api": "wrangler dev --config apps/api/wrangler.jsonc --port 8787",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local --config apps/api/wrangler.jsonc",
    "test:api": "node tests/api.integration.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "format": "prettier --write apps packages tests scripts *.json *.ts *.html .github/workflows/*.yml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.45.0"
  }
}
